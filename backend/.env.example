# Copier ce fichier en « .env » dans le dossier backend/ puis adapter les valeurs.
# Spring Boot le lit au démarrage (spring.config.import). Le fichier .env n'est jamais versionné.
# Les variables d'environnement du système restent prioritaires. Toutes les valeurs sont facultatives en local.

# ---------- Base MySQL (XAMPP : MariaDB, root sans mot de passe) ----------
# La base ironfit_db est créée automatiquement (createDatabaseIfNotExist=true).
DB_URL=jdbc:mysql://localhost:3306/ironfit_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Dialecte Hibernate. Défaut : com.ironfit.config.XamppMariaDbDialect (MySQL de XAMPP = MariaDB 10.4).
# Vrai serveur MySQL 8 / 9 : org.hibernate.dialect.MySQLDialect
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

# update (défaut, développement) : crée / complète les tables. validate : vérifie seulement (production).
DDL_AUTO=update
SHOW_SQL=false

# ---------- Serveur ----------
PORT=8080
# 0.0.0.0 : accessible depuis un téléphone du réseau local ; 127.0.0.1 : cette machine uniquement
HOST=0.0.0.0

# ---------- Sécurité ----------
# Clé de signature des jetons JWT (32 caractères minimum). Vide : clé aléatoire générée dans DATA_DIR/jwt.secret.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#          ou : powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"
IRONFIT_JWT_SECRET=
TOKEN_DAYS=7
DATA_DIR=./data

# Origines autorisées pour Flutter Web (CORS), séparées par des virgules. « * » convient en local (pas de cookie).
CORS_ORIGINS=*

# Tentatives de connexion / inscription / réinitialisation par minute, par IP et par route
RATE_LIMIT=10

# ---------- Données initiales (base vide uniquement) ----------
# Mot de passe du compte « admin » créé quand la base ne contient aucun utilisateur
ADMIN_PASSWORD=admin123
# Comptes et données de démonstration (coachs, membres, cours…)
SEED_DEMO=true
# Mot de passe oublié : renvoie le code à l'application (démo). En production : false + envoi d'e-mail.
SHOW_RESET_CODE=true
