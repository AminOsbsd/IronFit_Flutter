# ---------- Base MySQL (XAMPP) ----------
DB_URL=jdbc:mysql://localhost:3306/ironfit_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC
DB_USERNAME=root
DB_PASSWORD=
DDL_AUTO=update
SHOW_SQL=false

# ---------- Serveur ----------
PORT=8080
HOST=0.0.0.0

# ---------- Sécurité ----------
IRONFIT_JWT_SECRET=
TOKEN_DAYS=7
DATA_DIR=./data
CORS_ORIGINS=*
RATE_LIMIT=10

# ---------- Données initiales ----------
ADMIN_PASSWORD=admin123
SEED_DEMO=true
SHOW_RESET_CODE=true

# ---------- E-mails (facultatif, SMTP) ----------
# Sans spring.mail.host, aucun e-mail n'est envoyé (notifications dans l'application uniquement).
# Exemple Gmail : décommenter dans backend/.env avec un mot de passe d'application (jamais dans ce fichier versionné).
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=votre-adresse@gmail.com
# spring.mail.password=votre-mot-de-passe-d-application
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# MAIL_FROM=votre-adresse@gmail.com

# ---------- AI Coach (OpenRouter) ----------
# Clé lue uniquement par le serveur, jamais envoyée à l'application. Vide (ou laissée telle quelle) = AI Coach désactivé.
# Créer une clé : https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Modèle : https://openrouter.ai/models. Gratuit testé (nov. 2026) : réponse en ~0,4 s, bon français.
# Les modèles « :free » sont limités (50 requêtes/jour sans crédit) et parfois saturés : prévoir des secours.
# Payant peu coûteux et plus stable : anthropic/claude-haiku-5.5 (valeur par défaut si la ligne est absente).
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Secours essayés dans l'ordre si le modèle principal est saturé ou en panne (séparés par des virgules)
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# « Réflexion » avant de répondre : off (défaut, le plus rapide), low, medium, high, default.
# Avec la réflexion activée, les modèles gratuits testés mettaient 3-4 s de plus et pouvaient ne rien répondre.
OPENROUTER_REASONING=off
# En-têtes recommandés par OpenRouter (attribution de l'application)
OPENROUTER_SITE_URL=https://github.com/AminOsbsd/IronFit_Flutter
OPENROUTER_APP_TITLE=IronFit
# Délai pour recevoir le début de la réponse, durée maximale d'une réponse (secondes), longueur maximale (jetons)
AI_TIMEOUT_SECONDS=30
AI_MAX_DURATION_SECONDS=90
AI_MAX_TOKENS=700
# Messages AI Coach par minute et par utilisateur
AI_RATE_LIMIT=12
# Base de connaissances de la salle (horaires, règles, FAQ, consignes), relue automatiquement quand elle change
AI_KNOWLEDGE_FILE=knowledge/coach-knowledge.md

# ---------- Stripe (mode test éducatif uniquement) ----------
# Ne jamais mettre une clé sk_live_ ici. STRIPE_SECRET_KEY doit commencer par sk_test_.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_TEST_MODE=true
# Signature du webhook, distincte de la clé API.
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=http://localhost:5173
# Activer seulement après configuration de Stripe Tax et des codes fiscaux.
STRIPE_AUTOMATIC_TAX=false
# Par défaut les formules existantes sont payées une seule fois.
# Pour une formule récurrente, remplacer ID par son véritable identifiant :
# STRIPE_PLAN_ID_INTERVAL=month
# STRIPE_PLAN_ID_INTERVAL_COUNT=1
# STRIPE_PLAN_ID_TAX_CODE=code_fiscal_valide

STRIPE_CURRENCY=eur
