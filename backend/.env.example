# ---------- Base MySQL (XAMPP) ----------
DB_URL=jdbc:mysql://localhost:3306/ironfit_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC
DB_USERNAME=root
DB_PASSWORD=
DDL_AUTO=update
SHOW_SQL=false

# ---------- Serveur ----------
PORT=8080
HOST=0.0.0.0

# ---------- Sécurité ----------
IRONFIT_JWT_SECRET=
TOKEN_DAYS=7
DATA_DIR=./data
CORS_ORIGINS=*
RATE_LIMIT=10

# ---------- Données initiales ----------
ADMIN_PASSWORD=admin123
SEED_DEMO=true
SHOW_RESET_CODE=true

# ---------- E-mails (facultatif, SMTP) ----------
# Sans spring.mail.host, aucun e-mail n'est envoyé (notifications dans l'application uniquement).
# Exemple Gmail : décommenter dans backend/.env avec un mot de passe d'application (jamais dans ce fichier versionné).
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=votre-adresse@gmail.com
# spring.mail.password=votre-mot-de-passe-d-application
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# MAIL_FROM=votre-adresse@gmail.com

# ---------- AI Coach (OpenRouter) ----------
# Clé lue uniquement par le serveur, jamais envoyée à l'application. Vide (ou laissée telle quelle) = AI Coach désactivé.
# Créer une clé : https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Modèle (peu coûteux par défaut) : https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# En-têtes recommandés par OpenRouter (attribution de l'application)
OPENROUTER_SITE_URL=https://github.com/AminOsbsd/IronFit_Flutter
OPENROUTER_APP_TITLE=IronFit
# Délai pour recevoir le début de la réponse, durée maximale d'une réponse (secondes), longueur maximale (jetons)
AI_TIMEOUT_SECONDS=30
AI_MAX_DURATION_SECONDS=90
AI_MAX_TOKENS=700
# Messages AI Coach par minute et par utilisateur
AI_RATE_LIMIT=12
