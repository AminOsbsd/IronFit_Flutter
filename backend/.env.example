# Copier ce fichier en « .env » (même dossier) puis adapter les valeurs.
# Le fichier .env n'est jamais versionné. Toutes les variables sont facultatives en développement.

# development (défaut) ou production
NODE_ENV=development

# Adresse d'écoute de l'API
PORT=3000
HOST=0.0.0.0

# Dossier de la base SQLite (gym.db) et du secret généré (défaut : backend/data)
# DATA_DIR=./data

# Clé de signature des jetons (32 caractères minimum). Si absente, une clé aléatoire est
# générée dans data/secret au premier lancement. En production, préférez une variable d'environnement.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# IRONFIT_SECRET=

# Durée de validité d'une session, en jours
TOKEN_DAYS=7

# Mot de passe du compte « admin » créé quand la base est vide (obligatoire en production)
# ADMIN_PASSWORD=

# Données de démonstration (coachs, membres, cours…) quand la base est vide. Défaut : true hors production
# SEED_DEMO=true

# Mot de passe oublié : renvoie le code à l'application (démo). Défaut : true hors production.
# En production, laisser à false et brancher un envoi d'e-mail dans src/routes/auth.js (/api/forgot).
# SHOW_RESET_CODE=false

# Origine autorisée pour Flutter Web (CORS). « * » convient car l'API n'utilise pas de cookie.
CORS_ORIGIN=*

# Tentatives de connexion / inscription / réinitialisation autorisées par minute, par IP et par route
RATE_LIMIT=10
